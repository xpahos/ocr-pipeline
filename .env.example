# OpenAI
OPENAI_API_KEY=sk-...

# Vault root to watch (absolute path to your Obsidian vault or a subfolder)
OCR_VAULT_ROOT=/path/to/your/vault

# Model used for literal OCR. Formatting and verification use the same model unless
# their optional overrides are set.
OCR_MODEL=gpt-5.6-terra
OCR_FORMAT_MODEL=gpt-5.6-luna
# OCR_VERIFY_MODEL=gpt-5.6-terra

# Optional reasoning effort for models that support it.
OCR_REASONING_EFFORT=low

# Source representation for OCR and visual verification:
#   pdf = preserve the PDF text layer and send page images at OCR_PDF_DETAIL
#   png = render each page temporarily and send it at OCR_IMAGE_DETAIL
OCR_INPUT_MODE=pdf
OCR_PDF_DETAIL=high
OCR_IMAGE_DETAIL=original
OCR_IMAGE_DPI=300

# Markdown can be disabled independently. Verification modes:
#   uncertain = only chunks containing [?]/[illegible], or with human OCR instructions
#   always    = every chunk
#   off       = no visual verification
OCR_FORMATTING_ENABLED=true
OCR_VERIFY_MODE=uncertain

# Optional proxy for all OpenAI traffic (e.g. a corporate SOCKS5 proxy).
# Use socks5h:// so DNS is resolved by the proxy. http(s):// also supported.
# Leave empty for a direct connection.
# OCR_PROXY=socks5h://user:pass@proxy.corp:1080

# Read timeout in seconds for OpenAI calls (streaming transcriptions can run long)
OCR_REQUEST_TIMEOUT=600

# Quality-oriented chunking plus a conservative file-size bound.
OCR_MAX_PAGES=10
OCR_MAX_BYTES=33000000

# Seconds of quiet before a changed PDF is enqueued (debounces sync bursts)
OCR_DEBOUNCE_SECONDS=1.5

# Comma-separated glob patterns (relative to vault root) to ignore
OCR_IGNORE_GLOBS=.obsidian/**,.trash/**

# Logging
OCR_LOG_LEVEL=INFO

# Bounded retry on transient OpenAI errors (429/5xx)
OCR_MAX_RETRIES=3
